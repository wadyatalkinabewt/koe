# Koe configuration. Copy to config.yaml and override only what you need.

profile:
  user_name: null

meeting_options:
  root_folder: null
  save_audio: false
  save_markdown: false
  last_meeting_mode: online_one_on_one

recording_options:
  activation_key: ctrl+shift+space

model_options:
  common:
    language: null

transcription_options:
  provider: elevenlabs
  corrections:
    ack me: Acme
    north wnd: Northwind

misc:
  noise_on_completion: true
  snippets_folder: null
