# Koe configuration. Copy to config.yaml and override only what you need.

profile:
  user_name: null

meeting_options:
  root_folder: null
  save_audio: false
  save_markdown: false

recording_options:
  activation_key: ctrl+shift+space

model_options:
  common:
    language: null
    initial_prompt: null
  elevenlabs:
    keyterms_enabled: false

misc:
  hide_status_window: false
  noise_on_completion: true
  snippets_folder: null
