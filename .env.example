# Koe environment variables — copy to .env and fill in.

# Groq API key (required) — used for transcription via Whisper Large v3.
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter API key (optional) — used for:
#   - AI cleanup of long snippets (google/gemini-3-flash-preview)
#   - Meeting summaries (anthropic/claude-sonnet-4-6 via OpenRouter)
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
