# Koe Environment Variables
# Copy this file to .env and fill in your values

# Required for speaker diarization (pyannote models)
# Get token at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Server URL (desktop uses localhost, laptop uses desktop's Tailscale IP)
WHISPER_SERVER_URL=http://localhost:9876

# Optional: API token for server authentication
# If set, all non-public endpoints require X-API-Token header
# Use the same token on both server (desktop) and client (laptop)
KOE_API_TOKEN=

# OpenRouter API key — used for:
#   - AI cleanup of long snippets (google/gemini-3-flash-preview)
#   - AI meeting summaries (anthropic/claude-sonnet-4-6 via OpenRouter)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Groq API key for cloud transcription (no local GPU needed)
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=
