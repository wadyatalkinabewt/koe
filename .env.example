# Koe environment variables — copy to .env and fill in.

# ElevenLabs API key (required) — used for transcription via Scribe v2.
# Get a key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Groq API key (optional) — only used if model_options.transcription_provider=groq.
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter API key (optional) — used for:
#   - Meeting summaries (google/gemini-3.5-flash via OpenRouter)
#   - Manual cleanup-model benchmarks
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
